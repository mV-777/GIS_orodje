        <Option type="QString" name="color" value=""/>
        <Option type="QString" name="component_description" value="Priprava katastra stanovanjskih stavb"/>
        <Option type="double" name="component_height" value="30"/>
        <Option type="double" name="component_pos_x" value="1029"/>
